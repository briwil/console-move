# Console start-up animation: the 48 frames in frames/, looping, on black.
# The frames are already turned to the screen's upright (native, portrait) way, and cropped:
# each is the part of the full 400 x 1280 screen picture starting 32 px in from the left, at the top.
# Made from splash/loader-source/ (Brian's 1280 x 400 renders) by pi-app/splash/make-frames.py.
FRAMES = 48;
FPS = 30;                       # Plymouth redraws 50 times a second; this is how many frames that shows
Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0, 0, 0);
i = 0;
while (i < FRAMES) {
  frame[i] = Image("loader-" + i + ".png");
  i = i + 1;
}
sprite = Sprite(frame[0]);
sprite.SetX(Window.GetX() + (Window.GetWidth() - 400) / 2 + 32);
sprite.SetY(Window.GetY() + (Window.GetHeight() - 1280) / 2);
tick = 0;
fun refresh_callback() {
  global.tick = global.tick + 1;
  index = Math.Int(global.tick * global.FPS / 50);
  if (index >= global.FRAMES) {
    global.tick = 0;
    index = 0;
  }
  global.sprite.SetImage(global.frame[index]);
}
Plymouth.SetRefreshFunction(refresh_callback);
