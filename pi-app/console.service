[Unit]
Description=Console recorder
# no waiting for the network (about 1.4 s at boot): Wi-Fi, Link and updates connect later by themselves
After=sound.target
# the start-up animation keeps playing until the app is ready to take the screen: the app ends it
# itself and then tells systemd it has started (Type=notify), and only then may Plymouth's own quit run
Before=plymouth-quit.service plymouth-quit-wait.service
Conflicts=getty@tty1.service

[Service]
Type=notify
NotifyAccess=main
User=pi
Group=pi
SupplementaryGroups=video render input audio
WorkingDirectory=/home/pi/console/pi-app
Environment=SDL_VIDEODRIVER=kmsdrm
Environment=CONSOLE_NO_TERMINAL_KEYS=1
Environment=CONSOLE_SERVICE=1
ExecStart=/usr/bin/python3 /home/pi/console/pi-app/console.py
TTYPath=/dev/tty1
StandardInput=tty
StandardOutput=journal
StandardError=journal
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
