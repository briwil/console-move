[Unit]
Description=Console file page (http://console.local)
After=network-online.target avahi-daemon.service
Wants=network-online.target

[Service]
User=pi
Group=pi
WorkingDirectory=/home/pi/console/pi-app/web
ExecStart=/usr/bin/python3 /home/pi/console/pi-app/web/server.py --port 80
# lets the page use the normal web port (80) without running as root
AmbientCapabilities=CAP_NET_BIND_SERVICE
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
